{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.0.0",
  "description": "Save LinkedIn jobs, track your applications automatically, and spot red flags before you apply.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"]
}
